---
import Icon from '../../components/Icon.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Button from '../../components/Button.astro';
import assets from '../../data/assets.json';
import {residence} from '../../data/residence';
const a=assets as Record<string,string>;
const third=a['unitThird.imgRectangle146'];
const photos=[{src:a['unit.imgOpenInterior1'],alt:'Bedroom and sitting area with views towards Dubai'}, {src:a['unit.imgOpenInterior2'],alt:'A light-filled sitting room overlooking the water'},{src:third,alt:'Interior reference from the supplied residence presentation'}];
---
<Layout title="Unit 3402 | Atlantis The Royal Residences" description="Explore Unit 3402, a four-bedroom Signature Residence Type 2. View the floor plan, room dimensions, interiors and position on level 34.">
 <Header detail/>
 <main id="main" class="unit-page">
  <div class="unit-layout">
   <section class="unit-information" aria-labelledby="unit-title">
    <h1 id="unit-title" class="display">Unit: {residence.id}</h1>
    <p class="unit-type">{residence.bedrooms} bedroom {residence.type}</p>
    <div class="unit-photos">{photos.map((photo,index)=><button type="button" data-lightbox={photo.src} data-gallery="unit-interiors" data-caption={photo.alt} class:list={['photo-thumb',{'photo-thumb--third':index===2}]} aria-label={`View interior photograph ${index+1} of 3`}>{index===2?<img src={photo.src} width="2880" height="1920" alt={photo.alt} loading={index===0?'eager':'lazy'}/>:<ResponsiveImage src={photo.src} width="2880" height="1920" alt={photo.alt} loading={index===0?'eager':'lazy'} sizes="(max-width: 800px) max(228px, min(295px, calc(50vw - 29px))), 260px"/>}{index===1&&<span aria-hidden="true">3 photos <Icon name="arrow-up-right" size={14}/></span>}</button>)}</div>
    <dl class="unit-areas"><div><dt>Total area</dt><dd>{residence.totalArea.replace('sq m', 'sq\u00a0m')}</dd></div><div><dt>Balcony</dt><dd>{residence.balcony.replace('sq m', 'sq\u00a0m')}</dd></div></dl>
    <table class="room-table"><caption class="sr-only">Room dimensions, metric and imperial</caption><thead class="sr-only"><tr><th scope="col">Room</th><th scope="col">Metric dimensions</th><th scope="col">Imperial dimensions</th></tr></thead><tbody>{residence.rooms.map(([room,metric,imperial])=><tr><th scope="row">{room}</th><td>{metric}</td><td>{imperial}</td></tr>)}</tbody></table>
    <div class="unit-actions"><Button label="Register your interest" context="Unit 3402 interest"/><Button label="Request payment plan" context="Unit 3402 payment plan request" variant="outline"/></div>
   </section>
   <section id="floor-plan" class="plan-information" aria-label="Floor plan and orientation">
    <p class="plan-orientation">View towards the ocean</p>
    <button class="unit-plan" type="button" data-lightbox={a['unit.imgOpenPlanZoom']} data-caption="Unit 3402 • Four-bedroom Signature Residence Type 2 • Level 34" data-plan aria-label="Open the floor plan viewer"><img src={a['unit.imgOpenPlanZoom']} width="1832" height="1466" alt="Unit 3402 floor plan showing four bedrooms, living and dining rooms, kitchen, study and balcony"/></button>
    <div class="plan-bottom"><p class="plan-orientation">View towards The Palm</p><button type="button" class="link-line" data-lightbox={a['unit.imgOpenPlanZoom']} data-caption="Unit 3402 • Four-bedroom Signature Residence Type 2 • Level 34" data-plan>Enlarge floor plan <Icon name="arrow-up-right" size={14}/></button></div>
    <p class="plan-notice">Floor plans shown are for guidance only; they are under regular review and subject to design development. Exact layouts and sizes may change, and sizes may vary within a tolerance of 5%. Furniture layouts are indicative only.</p>
    <div class="orientation-diagrams"><figure><figcaption>Building</figcaption><img src={a['unit.imgBuildingDiagram']} width="2178" height="1046" alt="The building elevation with the residence position marked" loading="lazy"/></figure><figure><figcaption>Level 34</figcaption><img src={a['unit.imgLevel34Diagram']} width="1270" height="706" alt="Level 34 diagram showing the position and orientation of the residence" loading="lazy"/></figure></div>
   </section>
  </div>
  <div class="unit-back"><a class="link-line" href="/#plans"><Icon name="arrow-left" size={14}/> Return to the residences</a><a class="link-line" href="/privacy/">Privacy notice</a></div>
 </main>
</Layout>
<style>
.unit-page{background:var(--cream);min-height:calc(100dvh - 80px);padding:30px var(--page-gutter) 50px}.unit-layout{max-width:1440px;margin:auto;display:grid;grid-template-columns:minmax(360px,440px) minmax(0,786px);gap:64px;justify-content:center}.unit-information h1{font-size:44px;line-height:48px}.unit-type{font-weight:300;font-size:13px;line-height:18px;letter-spacing:-.03em;text-transform:uppercase;margin-top:18px}.unit-photos{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0;position:relative}.photo-thumb{padding:0;position:relative;height:146px;overflow:hidden}.photo-thumb img{height:100%;width:100%;object-fit:cover;transition:transform .5s}.photo-thumb:hover img{transform:scale(1.04)}.photo-thumb span{position:absolute;right:8px;bottom:8px;background:rgba(4,25,39,.75);padding:3px 8px;color:white;font-size:10px;line-height:1.6}.photo-thumb--third{position:absolute;left:0;top:0;width:1px;height:1px;opacity:0;pointer-events:none;overflow:hidden;visibility:hidden}.unit-areas{display:flex;gap:24px;margin:18px 0 24px;text-transform:uppercase}.unit-areas>div{flex:1}.unit-areas dt{font-size:12px;line-height:16px;letter-spacing:-.03em}.unit-areas dd{font-size:22px;line-height:26px;letter-spacing:-.03em;margin:6px 0 0;font-weight:300}.unit-areas>div:first-child dd{font-weight:400}.room-table{width:100%;border-collapse:collapse;font-size:13px;line-height:20px;text-transform:uppercase;letter-spacing:-.04em;table-layout:fixed}.room-table th,.room-table td{height:33px;border-bottom:1px solid var(--line);text-align:left;padding:5px 6px 5px 0;white-space:nowrap}.room-table th{font-weight:400;width:35.45%}.room-table td{font-weight:300;width:38.18%;font-size:12.5px}.room-table td:last-child{width:21.82%;padding-right:0;text-align:right;font-size:12px}.unit-actions{display:flex;flex-direction:column;gap:14px;margin-top:18px;align-items:flex-start}.unit-actions :global(.pill){min-width:280px}.plan-information{padding-top:2px}.plan-orientation{font-size:12px;line-height:18px;text-transform:uppercase;font-weight:300;text-align:center;letter-spacing:-.01em}.unit-plan{display:block;padding:0;width:100%;margin:20px 0}.unit-plan img{width:100%;height:auto;object-fit:contain}.plan-bottom{display:flex;align-items:center;justify-content:center;gap:24px;flex-wrap:wrap}.plan-bottom .link-line{font-size:10px;padding:0 0 4px}.plan-notice{font-size:12px;line-height:18px;letter-spacing:-.01em;font-weight:300;color:#767d81;margin:26px 0 24px}.orientation-diagrams{display:grid;grid-template-columns:1fr 1fr;gap:32px}.orientation-diagrams figcaption{font-size:12px;line-height:16px;text-transform:uppercase;margin-bottom:8px}.orientation-diagrams img{width:100%;height:auto;mix-blend-mode:darken}.unit-back{max-width:1290px;margin:60px auto 0;display:flex;justify-content:space-between;gap:24px}.unit-back .link-line{font-size:10px}
@media(max-width:1100px) and (min-width:801px){.unit-page{padding-inline:40px}.unit-layout{grid-template-columns:minmax(330px,380px) minmax(0,1fr);gap:40px}.room-table{font-size:12px}.room-table td{font-size:11px}.room-table td:last-child{font-size:10px}.room-table th{width:34%}.room-table td{width:42%}.room-table td:last-child{width:24%}.photo-thumb{height:130px}}
@media(max-width:800px){.unit-page{padding:28px 24px 40px}.unit-layout{display:block;max-width:600px}.unit-information h1{font-size:40px;line-height:44px}.unit-type{font-size:12px;margin-top:12px}.unit-photos{gap:10px;margin:22px 0}.photo-thumb{height:128px}.unit-areas{margin:24px 0;gap:16px}.unit-areas dd{font-size:22px}.room-table{font-size:12px;letter-spacing:-.02em}.room-table th{width:36%;height:44px}.room-table td{font-size:13px;width:64%;white-space:normal;padding-left:8px}.room-table td:last-child{display:none}.unit-actions{margin-top:24px;gap:14px}.unit-actions :global(.pill){width:100%;min-width:0}.plan-information{margin-top:48px}.unit-plan{margin:18px 0}.plan-bottom{gap:16px}.plan-notice{font-size:11px;line-height:18px;margin-top:24px}.orientation-diagrams{gap:18px}.orientation-diagrams figcaption{font-size:10px}.unit-back{margin-top:44px;align-items:flex-start}.unit-back .link-line{font-size:9px;max-width:65%}}
</style>
