---
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import assets from '../data/assets.json';
import Button from './Button.astro';
const a=(key:string)=>(assets as Record<string,string>)[`location.${key}`];
---
<section id="location" class="location section-anchor" aria-labelledby="location-title">
 <div class="address-story">
  <p class="location-kicker editorial" data-reveal>Dubai, a truly</p>
  <h2 id="location-title" class="location-title display" data-reveal>Global address<br/>and dynamic<br/>destination</h2>
  <div class="statue" style={`--mask:url('${a('imgImage6Photoroom2')}')`} aria-hidden="true"><img src={a('imgImage6Photoroom3')} alt="" loading="lazy" width="893" height="1159"/></div>
  <div class="address" data-reveal><img class="address-marker" src={a('imgRectangle108')} width="21" height="21" alt="" loading="lazy"/><p>The address for Atlantis The Royal Residences is <span>Crescent Road, The Palm, Dubai, United Arab Emirates.</span> It is located on the crescent of The Palm Jumeirah, next to the existing Atlantis resort.</p><a class="link-line" href="https://www.google.com/maps/search/?api=1&query=Atlantis+The+Royal+Residences+Dubai" target="_blank" rel="noopener noreferrer">Open location <Icon name="arrow-up-right" size={14}/></a></div>
  <blockquote class="dubai-story" data-reveal><img src={a('imgQuoteRightSvgrepoCom1')} width="28" height="28" alt="" loading="lazy"/><p>When <em>Greek philosopher Plato</em> described the citizens of ancient Atlantis as great and prosperous people, he was also foretelling the story of modern Dubai. Today, the 200 nationalities living and working in the city confirm its status as a <em>vibrant global destination.</em> The arrival of Atlantis, The Royal Resort &amp; Residences will continue to grow the city’s enduring appeal to <em>discerning world citizens.</em></p></blockquote>
  <div class="map-composition"><div class="map-art" style={`--mask:url('${a('imgShutterstock20871900491')}')`}><img src={a('imgShutterstock20871900492')} alt="Illustrated aerial view of Palm Jumeirah and the Dubai coastline" loading="lazy" width="2116" height="1190"/></div>
  <div class="map-marker map-marker--royal" aria-hidden="true"><img class="marker-shape" src={a('imgRectangle107')} width="128" height="128" alt="" loading="lazy"/><span><ResponsiveImage src={a('img121')} alt="" loading="lazy" width="218" height="155" sizes="(max-width: 800px) 60px, 15.1322vw"/></span></div>
  <div class="map-marker map-marker--palm" aria-hidden="true"><img class="marker-palm" src={a('imgGroup1000003297')} width="116" height="116" alt="" loading="lazy"/><span><ResponsiveImage src={a('imgImage4')} alt="" loading="lazy" width="97" height="61" sizes="(max-width: 800px) 27px, 6.7363vw"/></span></div></div>
 </div>
 <div class="ascent" data-scene="ascent">
  <div class="ascent-sky" aria-hidden="true"></div>
  <ResponsiveImage class="cloud cloud--one" src={a('imgImage7')} alt="" loading="lazy" width="1744" height="603" sizes="(max-width: 800px) 920px, 121.14vw"/>
  <ResponsiveImage class="cloud cloud--two" src={a('imgImage7')} alt="" loading="lazy" width="1744" height="603" sizes="(max-width: 800px) 920px, 121.14vw"/>
  <ResponsiveImage class="cloud cloud--three" src={a('imgImage7')} alt="" loading="lazy" width="1744" height="603" sizes="(max-width: 800px) 920px, 121.14vw"/>
  <ResponsiveImage class="cloud cloud--four" src={a('imgImage7')} alt="" loading="lazy" width="1442" height="498" sizes="(max-width: 800px) 920px, 100.13vw"/>
  <p class="ascent-kicker editorial" data-reveal>Residences soaring over</p>
  <h2 class="ascent-height display" data-reveal><span>150</span><span>metres</span></h2>
  <p class="ascent-caption" data-reveal>Above the sea<br/>An ideal society, likely<br/><em>to be most perfect</em></p>
  <div class="building-elevation" data-parallax="-4"><ResponsiveImage src={a('img31')} alt="The Royal Residences rising above the beachfront" width="1476" height="1656" loading="lazy" sizes="(max-width: 800px) 779px, 102.5vw"/></div>
  <img class="building-emblem" src={a('imgGroup1000003337')} alt="" width="99" height="87" loading="lazy"/>
  <div class="ascent-ocean" style={`--mask:url('${a('imgShutterstock17915352412')}');--wave-mask:url('${a('imgShutterstock17915352413')}')`} aria-hidden="true"><img src={a('imgShutterstock17915352414')} alt="" loading="lazy" width="3615" height="1327"/></div>
  <div class="ocean-tint" style={`--mask:url('${a('imgShutterstock17915352412')}');--wave-mask:url('${a('imgRectangle137')}')`} aria-hidden="true"></div>
  <div class="shore-overlay" style={`--mask:url('${a('img32')}')`} aria-hidden="true"><ResponsiveImage src={a('img31')} alt="" loading="lazy" width="1476" height="1656" sizes="(max-width: 800px) 779px, 102.5vw"/></div>
  <div class="invitation" data-reveal>
   <img class="invitation-shape" src={a('imgExclude')} width="661" height="587" alt="" loading="lazy"/>
   <p class="eyebrow">The residences</p>
   <h2 class="display"><em>Like citizens<br/>of ancient Atlantis,</em><br/>be furnished<br/>with everything<br/>which is needed</h2>
   <Button label="Show more highlights" href="#highlights" variant="light"/>
  </div>
 </div>
</section>
<style>
.location{position:relative;background:var(--cream);overflow:hidden}.address-story{position:relative;height:147.9861vw}.location-kicker{position:absolute;left:0;top:8.1944vw;width:100%;text-align:center;font-size:1.3889vw;z-index:2}.location-title{position:absolute;top:12.4306vw;left:50%;transform:translateX(-50%);font-size:6.9444vw;line-height:.958;width:63.1944%;color:var(--gold);text-align:center;z-index:2}.statue{position:absolute;top:16.7361vw;left:14.2256%;width:62.0475vw;height:80.5183vw;mask-image:var(--mask);mask-size:100% 100%;mask-position:-2.6283vw 0;mask-repeat:no-repeat;mix-blend-mode:luminosity;opacity:.9}.statue img{width:100%;height:100%;opacity:.8;object-position:bottom}.address{position:absolute;top:36.72vw;left:5.2083%;width:14.5833%;font-size:12px;line-height:1.888;text-transform:uppercase;z-index:3}.address-marker{transform:rotate(45deg);margin-bottom:30px}.address span{color:rgba(4,25,39,.55)}.address a{display:inline-block;margin-top:20px;font-size:10px}.dubai-story{position:absolute;top:37.0139vw;left:66.3194%;width:26.6667%;margin:0;z-index:3}.dubai-story>img{margin-bottom:27px}.dubai-story p{font-size:.9722vw;line-height:1.888;letter-spacing:-.01em}.dubai-story em{font-size:1.214em;color:var(--gold)}.map-art{position:absolute;top:67.0139vw;left:0;width:100%;height:80.9722vw;overflow:hidden;mask-image:var(--mask);mask-size:100% 100%;mask-repeat:no-repeat}.map-art img{width:146.9139vw;height:82.6389vw;max-width:none;position:absolute;left:-24.3056vw;top:0;opacity:.58;object-fit:cover;mix-blend-mode:multiply}.map-art::after{content:'';position:absolute;inset:0;background:linear-gradient(var(--cream),transparent 20%,transparent 80%,var(--cream));pointer-events:none}.map-marker{position:absolute;z-index:3}.map-marker--royal{top:65.9028vw;left:53.09%;width:12.5322vw;height:12.5322vw}.marker-shape{position:absolute;left:14.64%;top:14.64%;width:8.8616vw;height:8.8616vw;max-width:none;transform:rotate(45deg)}.map-marker--royal span{position:absolute;left:7.55%;top:23.21%;width:83.4%;height:49%;overflow:hidden}.map-marker--royal span img{position:absolute;width:144.78%;height:175.35%;max-width:none;left:-22.39%;top:-37.67%}.map-marker--palm{top:70.4675vw;left:46.1618%;width:8.0556vw;height:8.0556vw}.marker-palm{width:8.0556vw;height:8.0556vw}.map-marker--palm span{position:absolute;left:14.9%;top:18.33%;width:69.83%;height:52.59%;overflow:hidden}.map-marker--palm span img{width:119.75%;height:100.55%;position:absolute;max-width:none;left:-9.88%;top:-.28%}.ascent{position:relative;height:209.5833vw;background:var(--navy);color:white}.ascent-sky{position:absolute;top:-19.375vw;left:-11.8vw;width:123.6vw;height:112vw;background:radial-gradient(ellipse at 70% 100%,var(--navy) 27%,#094f7e 50%,#658eaa 68%,var(--cream) 88%);filter:blur(3.5vw);z-index:0}.ascent::after{content:'';position:absolute;top:8vw;left:0;width:100%;height:86vw;background:linear-gradient(transparent,rgba(4,25,39,.1) 40%,var(--navy));pointer-events:none}.cloud{position:absolute;max-width:none;filter:blur(7px);z-index:1;pointer-events:none}.cloud--one{top:0;left:-8.11vw;width:121.14vw;height:41.88vw;opacity:.225}.cloud--two{top:20.19vw;left:-83.05vw;width:121.14vw;height:41.88vw;opacity:.054}.cloud--three{top:16.66vw;left:68vw;width:121.14vw;height:41.88vw;opacity:.054}.cloud--four{top:30.59vw;left:-1.18vw;width:100.13vw;height:34.61vw;opacity:.018}.ascent-kicker{position:absolute;top:9.2361vw;left:0;width:100%;text-align:center;font-size:1.6667vw;z-index:3}.ascent-height{position:absolute;top:14.375vw;left:50%;transform:translateX(-50%);width:62.5%;font-size:13.75vw;line-height:.858;color:#e4d2c3;text-align:center;z-index:3}.ascent-height span{display:block}.ascent-caption{position:absolute;top:38.8194vw;left:50%;transform:translateX(-50%);width:384px;max-width:80%;text-align:center;text-transform:uppercase;font-size:1.6667vw;line-height:1.388;z-index:3;font-weight:300}.ascent-caption em{font-size:1.25em;line-height:1.158;text-transform:lowercase;color:#dec2a6}.building-elevation{position:absolute;top:32.8472vw;left:0;width:100%;height:115vw;overflow:hidden;z-index:2}.building-elevation img{position:absolute;width:102.5%;height:100.02%;max-width:none;left:-2.36%;top:-.01%;object-fit:cover}.building-emblem{position:absolute;top:86.5484vw;left:46.8056%;width:6.875vw;height:6.07vw;z-index:3}.ascent-ocean{position:absolute;top:121.5278vw;left:-89.5833vw;width:251.0417vw;height:92.1528vw;mask-image:var(--mask),var(--wave-mask);mask-size:100vw 99.4444vw,100% 100%;mask-position:89.5833vw -7.2917vw,0 0;mask-repeat:no-repeat;mask-composite:intersect;z-index:2}.ascent-ocean img{width:100%;height:100%;object-position:bottom;opacity:.6}.shore-overlay{position:absolute;top:125.9722vw;left:0;width:100%;height:21.875vw;mask-image:var(--mask);mask-size:100% 100%;overflow:hidden;z-index:3}.shore-overlay img{position:absolute;width:102.5%;height:525.84%;max-width:none;left:-2.36%;top:-425.78%}.invitation{position:absolute;top:159.7222vw;left:50%;transform:translateX(-50%);width:45.9028vw;height:40.7639vw;z-index:4;text-align:center;padding-top:3.4vw}.invitation-shape{position:absolute;inset:0;width:45.9028vw;height:40.7639vw;z-index:-1;max-width:none}.invitation>.eyebrow{font-family:var(--editorial);font-size:1.0417vw;letter-spacing:-.02em}.invitation h2{font-size:3.9583vw;color:#d3b496;line-height:1.048;margin:3.8889vw auto 3.3333vw;width:67.3%}.invitation h2 em{text-transform:none;letter-spacing:-.02em}.invitation :global(.pill){min-width:216px}
@media(max-width:1100px) and (min-width:801px){.address{font-size:10px}.dubai-story p{font-size:12px}.invitation :global(.pill){min-height:45px;padding:10px 16px;font-size:10px}}
@media(max-width:800px){.address-story{height:1320px}.location-kicker{top:22px;font-size:22px}.location-title{top:78px;font-size:44px;width:calc(100% - 48px);max-width:520px;line-height:1.02}.statue{top:180px;left:calc(50% - 270px);width:540px;height:701px;mask-position:-23px 0;opacity:.5}.address{top:330px;left:24px;width:calc(100% - 48px);max-width:500px;font-size:12px;line-height:1.8}.address-marker{margin-bottom:20px}.address p{max-width:300px}.address a{margin-top:16px}.dubai-story{top:590px;left:24px;width:calc(100% - 48px);max-width:500px}.dubai-story>img{margin-bottom:16px}.dubai-story p{font-size:14px;line-height:1.85}.map-art{top:850px;height:470px;mask-size:100% 100%}.map-art img{width:850px;height:478px;left:calc(50% - 425px);opacity:.6}.map-marker--royal{top:870px;left:calc(50% + 12px);width:100px;height:100px}.marker-shape{width:70.7px;height:70.7px}.map-marker--palm{top:918px;left:calc(50% - 52px);width:64px;height:64px}.marker-palm{width:64px;height:64px}.ascent{height:1500px}.ascent-sky{top:-80px;left:-100px;width:calc(100% + 200px);height:770px;background:radial-gradient(ellipse at 70% 100%,var(--navy) 24%,#094f7e 52%,#658eaa 68%,var(--cream) 90%);filter:blur(26px)}.cloud--one{top:10px;left:calc(50% - 460px);width:920px;height:318px}.cloud--two{top:180px;left:-660px;width:920px;height:318px}.cloud--three{top:220px;left:180px;width:920px;height:318px}.cloud--four{top:350px;left:-180px;width:920px;height:318px}.ascent-kicker{top:80px;font-size:24px}.ascent-height{top:142px;font-size:128px;width:calc(100% - 48px);line-height:1}.ascent-height span:last-child{font-size:64px;line-height:72px}.ascent-caption{top:620px;font-size:20px;width:342px}.building-elevation{top:300px;width:760px;height:874px;left:calc(50% - 380px);transform:none!important}.building-emblem{top:652px;left:calc(50% - 21px);width:42px;height:37px}.ascent-ocean{top:960px;left:calc(50% - 920px);width:1840px;height:676px;mask-size:730px 728px,1840px 676px;mask-position:555px -54px,0 0}.shore-overlay{top:1014px;height:160px;width:760px;left:calc(50% - 380px)}.ascent::after{height:740px;top:0}.invitation{top:1050px;width:342px;max-width:calc(100% - 48px);height:430px;padding-top:38px;transform:translateX(-50%)}.invitation-shape{width:100%;height:430px;object-fit:fill}.invitation>.eyebrow{font-size:13px}.invitation h2{font-size:32px;width:90%;line-height:1.08;margin:34px auto 30px}.invitation :global(.pill){min-width:240px}}
</style>
<style>
.map-composition{display:contents}.ocean-tint{position:absolute;left:-28.2639vw;top:105vw;width:141.4583vw;height:106.1111vw;background:#062f47;mix-blend-mode:overlay;mask-image:var(--mask),var(--wave-mask);mask-size:100vw 99.4444vw,251.0417vw 92.1528vw;mask-position:28.2639vw 9.2361vw,-61.3194vw 16.5278vw;mask-repeat:no-repeat;mask-composite:intersect;z-index:2;pointer-events:none}
@media(max-width:800px){.address-story{height:auto;display:flex;flex-direction:column;align-items:center;gap:28px;padding:64px 24px}.location-kicker{position:static;font-size:28px;line-height:32px;order:0}.location-title{position:static;transform:none;font-size:48px;line-height:50px;max-width:520px;width:100%;order:1}.statue{display:none}.dubai-story{position:static;width:100%;max-width:520px;order:2}.dubai-story>img{display:none}.dubai-story p{font-size:16px;line-height:24px;letter-spacing:-.01em}.dubai-story em{font:inherit;color:inherit}.map-composition{position:relative;display:block;order:3;width:calc(100% + 48px);height:320.12px;max-width:680px;margin-inline:-24px}.map-art{top:4.33px;height:315.79px;left:0;width:100%}.map-art img{width:572.96px;height:322.29px;left:calc(50% - 286.48px);opacity:.8}.map-marker--royal{top:0;left:53.09%;width:48.875px;height:48.875px}.marker-shape{width:34.56px;height:34.56px}.map-marker--palm{top:17.8px;left:46.16%;width:31.417px;height:31.417px}.marker-palm{width:31.417px;height:31.417px}.address{position:static;order:4;width:100%;max-width:520px;font-size:16px;line-height:24px}.address-marker{display:none}.address p{max-width:none}.address span{color:var(--navy)}.address a{display:flex;align-items:center;justify-content:center;width:280px;max-width:100%;min-height:57px;border:1px solid var(--navy);border-radius:70px;padding:16px 24px;margin:28px auto 0;font-size:12px;line-height:20px}.ocean-tint{top:840px;left:calc(50% - 568px);width:1036px;height:778px;mask-size:730px 728px,1840px 676px;mask-position:207px 68px,-449px 121px}}
</style>
