---
import Icon from './Icon.astro';
import assets from '../data/assets.json';
import Emblem from './Emblem.astro';
const {detail=false}=Astro.props;
const navigation=[['About','about'],['Location','location'],['Highlights','highlights'],['Plans','plans'],['Interiors','interiors'],['Contacts','contacts']];
---
<header class:list={['site-header',{'site-header--detail':detail}]} data-site-header>
  <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-menu"><Emblem /><span class="mobile-menu-glyph" aria-hidden="true"><Icon name="menu" size={24}/></span></button>
  {detail ? <a class="detail-name" href="/">Atlantis The Royal Residences</a> : <nav class="desktop-nav" aria-label="Main navigation">
    {navigation.slice(0,3).map(([label,id])=><a href={`/#${id}`}>{label}</a>)}
    <a class="wordmark" style={`--logo:url('${assets['hero.imgMaskGroup2']}')`} href="/" aria-label="Atlantis The Royal Residences, home"></a>
    {navigation.slice(3).map(([label,id])=><a href={`/#${id}`}>{label}</a>)}
  </nav>}
  {!detail&&<a class="mobile-logo wordmark" style={`--logo:url('${assets['hero.imgMaskGroup2']}')`} href="/" aria-label="Atlantis The Royal Residences, home"></a>}
  {detail ? <a class="detail-close" href="/#plans" aria-label="Return to residences"><Icon name="close" size={22}/></a> : <button class="reach" type="button" data-enquire="General enquiry">Reach <img src={assets['hero.imgStar1']} width="14" height="16" alt=""/></button>}
</header>
<dialog id="site-menu" class="site-menu" aria-labelledby="menu-title">
  <button class="dialog-close" type="button" data-close aria-label="Close navigation"><Icon name="close" size={22}/></button>
  <div class="menu-scroll" data-dialog-scroll>
  <p id="menu-title" class="eyebrow">Atlantis The Royal Residences</p>
  <nav aria-label="Expanded navigation">{navigation.map(([label,id],i)=><a href={`/#${id}`}><span class="eyebrow">0{i+1}</span><span class="display">{label}</span></a>)}</nav>
  <button class="link-line" type="button" data-enquire="General enquiry">Register your interest</button>
  <p class="menu-address">Crescent Road, The Palm<br/>Dubai, United Arab Emirates</p>
  </div>
</dialog>
<style>
.site-header{position:absolute;top:0;left:0;width:100%;height:110px;display:flex;align-items:center;justify-content:space-between;padding:0 var(--page-gutter);color:white;z-index:20}.menu-toggle{width:44px;height:44px;display:grid;place-items:center;margin-left:-10px}.desktop-nav{position:absolute;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:clamp(20px,3.264vw,60px);white-space:nowrap}.desktop-nav>a:not(.wordmark),.reach{font-size:12px;line-height:1;letter-spacing:-.05em;text-transform:uppercase;padding:15px 0}.desktop-nav>a:not(.wordmark){position:relative}.desktop-nav>a:not(.wordmark)::after{content:'';position:absolute;bottom:6px;left:0;width:100%;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .3s}.desktop-nav>a:hover::after{transform:scaleX(1)}.wordmark{display:block;width:115.3px;height:69px;background:currentColor;mask-image:var(--logo);mask-size:contain;mask-repeat:no-repeat;mask-position:center;flex:none}.mobile-logo{display:none}.reach{display:flex;gap:6px;align-items:center;min-height:44px}.reach img{width:14px;height:16px}.site-header--detail{position:relative;height:80px;color:var(--navy);padding:0 60px}.detail-name{font-size:12px;line-height:1.4;text-transform:uppercase;text-align:center}.detail-close{width:44px;height:44px;display:grid;place-items:center;font-size:24px}.site-menu{width:660px;padding:0;overflow:hidden}.site-menu>.dialog-close{background:var(--cream)}.menu-scroll{margin-top:70px;padding:0 64px 56px;max-height:calc(100dvh - 102px);overflow:auto;overscroll-behavior:contain}.site-menu nav{display:flex;flex-direction:column;margin:40px 0 24px}.site-menu nav a{display:flex;align-items:baseline;gap:20px;padding:12px 0;border-top:1px solid var(--line)}.site-menu nav a:last-child{border-bottom:1px solid var(--line)}.site-menu nav a .display{font-size:44px;transition:color .2s}.site-menu nav a:hover .display{color:var(--gold)}.menu-address{font-size:12px;margin-top:32px;opacity:.7}
@media(max-width:1100px) and (min-width:801px){.desktop-nav{gap:18px}.desktop-nav>a:not(.wordmark){font-size:10px}.wordmark{width:100px}.reach{font-size:10px}}
@media(max-width:800px){.site-header{height:80px;padding:0 24px;background:var(--navy)}.desktop-nav{display:none}.mobile-logo{display:block;position:absolute;left:50%;transform:translateX(-50%);width:98px;height:59px}.reach{font-size:10px}.menu-toggle{margin-left:-10px}.site-header--detail{background:var(--cream);height:72px;padding:0 24px}.detail-name{font-size:10px;max-width:200px}.menu-scroll{padding:0 28px 36px;max-height:calc(100dvh - 94px)}.site-menu nav{margin-top:30px}.site-menu nav a .display{font-size:38px}}
</style>
<style>.mobile-menu-glyph{display:none}@media(max-width:800px){.site-header:not(.site-header--detail) .menu-toggle :global(.emblem){display:none}.site-header:not(.site-header--detail) .mobile-menu-glyph{display:grid;place-items:center;width:24px;height:24px}.site-header:not(.site-header--detail){padding-inline:16px}.site-header:not(.site-header--detail) .menu-toggle{margin-left:0}.site-header:not(.site-header--detail) .reach{width:44px;justify-content:center;padding:0}.site-header:not(.site-header--detail) .reach img{display:none}}</style>
