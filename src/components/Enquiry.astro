---
import Icon from './Icon.astro';
import Button from './Button.astro';
---
<dialog id="enquiry-dialog" class="enquiry-dialog" aria-labelledby="enquiry-title">
 <button class="dialog-close" type="button" data-close aria-label="Close enquiry"><Icon name="close" size={22}/></button>
 <div class="enquiry-scroll" data-dialog-scroll>
 <div data-form-content>
  <p class="eyebrow">Atlantis The Royal Residences</p>
  <h2 id="enquiry-title">Register your interest</h2>
  <p class="enquiry-context" data-enquiry-context>General enquiry</p>
  <form id="enquiry-form" novalidate>
   <div class="field"><label for="enquiry-name">Full name</label><input id="enquiry-name" name="name" type="text" autocomplete="name" placeholder="Enter your name" required maxlength="100" aria-describedby="name-error"/><p class="form-error" id="name-error" data-error="name" hidden></p></div>
   <div class="field"><label for="enquiry-email">Email</label><input id="enquiry-email" name="email" type="email" autocomplete="email" placeholder="Enter your email" required maxlength="254" aria-describedby="email-error"/><p class="form-error" id="email-error" data-error="email" hidden></p></div>
   <div class="field"><label for="enquiry-phone">Phone (optional)</label><input id="enquiry-phone" name="phone" type="tel" autocomplete="tel" placeholder="Enter your phone number" maxlength="30" aria-describedby="phone-error"/><p class="form-error" id="phone-error" data-error="phone" hidden></p></div>
   <div class="honeypot" aria-hidden="true"><label for="enquiry-website">Leave this field empty</label><input id="enquiry-website" type="text" name="website" tabindex="-1" autocomplete="off"/></div>
   <div class="consent"><label><input type="checkbox" name="consent" required aria-describedby="consent-error"/><span>I agree to be contacted about this enquiry.</span></label><p class="form-error" id="consent-error" data-error="consent" hidden></p></div>
   <p class="privacy-copy">Your details are used to respond to this request. <a href="/privacy/" target="_blank" rel="noopener">Privacy notice</a>.</p>
   <div class="submission-message" role="status" aria-live="polite" tabindex="-1" data-form-message hidden></div>
   <Button label="Send enquiry" type="submit"/>
  </form>
 </div>
 <div class="success-panel" data-form-success hidden tabindex="-1">
  <p class="eyebrow">Enquiry received</p>
  <h2>Thank you<br/>for your interest.</h2>
  <p>Your enquiry has been saved. We will use the details you provided to respond.</p>
  <button class="pill pill--outline" type="button" data-close>Continue exploring</button>
 </div>
 </div>
</dialog>
<style>
.enquiry-dialog{width:680px;padding:0;overflow:hidden}.enquiry-dialog>.dialog-close{background:var(--cream)}.enquiry-scroll{margin-top:62px;padding:0 80px 64px;max-height:calc(100dvh - 94px);overflow:auto;overscroll-behavior:contain}.enquiry-dialog h2{font-family:var(--display);font-size:56px;line-height:1.04;letter-spacing:-.02em;margin:16px 0}.enquiry-context{font:italic 20px/1.4 var(--editorial);color:#72614f;margin:0 0 12px}.field{padding:12px 0 16px;margin:0 0 14px;position:relative}.field label{display:block;text-transform:uppercase;font-size:12px;line-height:16px;margin-bottom:16px}.field input{display:block;width:100%;height:42px;padding:0 0 14px;border:none;border-bottom:1px solid var(--line);border-radius:0;background:transparent;color:var(--navy);font-size:16px;line-height:24px;outline:none}.field input:focus{border-bottom-color:var(--navy);box-shadow:0 1px 0 var(--navy)}.field input[aria-invalid=true]{border-bottom-color:#962f21}.field .form-error{padding-top:8px}.consent{margin:14px 0}.consent label{display:flex;align-items:flex-start;gap:12px;font-size:14px;line-height:20px;cursor:pointer;padding:8px 0}.consent input{appearance:none;width:20px;height:20px;flex:none;border:1px solid var(--navy);background:transparent;margin:0;display:grid;place-items:center}.consent input:checked{background:var(--navy)}.consent input:checked::after{content:'✓';color:white;font-size:15px}.privacy-copy{font-size:11px;line-height:1.5;color:#5a6265;margin:0 0 24px}.privacy-copy a{text-decoration:underline}.enquiry-dialog :global(.pill){min-width:280px}.submission-message{font-size:14px;line-height:1.6;background:#f3e7de;border-left:2px solid #962f21;padding:14px 16px;margin:0 0 20px}.honeypot{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.success-panel{padding:32px 0}.success-panel p:not(.eyebrow){font-size:16px;line-height:1.8;margin:26px 0 32px}.success-panel h2{margin-top:22px}
@media(max-width:800px){.enquiry-dialog{width:500px}.enquiry-scroll{margin-top:58px;padding:0 24px 32px;max-height:calc(100dvh - 82px)}.enquiry-dialog h2{font-size:40px;line-height:1.08}.field{margin-bottom:8px}.enquiry-dialog :global(.pill){width:100%;min-width:0}.success-panel{padding:24px 0}.success-panel h2{font-size:42px}}
</style>
