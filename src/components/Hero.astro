---
import ResponsiveImage from './ResponsiveImage.astro';
import assets from '../data/assets.json';
import Header from './Header.astro';
import Button from './Button.astro';
---
<section class="hero-myth" aria-labelledby="hero-title">
 <Header/>
 <div class="underwater" style={`--mask:url('${assets['hero.imgShutterstock22659398172']}')`} aria-hidden="true"><img src={assets['hero.imgShutterstock22659398173']} alt="" width="1024" height="1024"/></div>
 <div class="sunset-art" style={`--mask:url('${assets['hero.imgImage']}')`} aria-hidden="true" data-parallax="-8">
  <ResponsiveImage class="tile tile--tl" src={assets['hero.imgImage4']} alt="" width="2735" height="2366" fetchpriority="high" sizes="(max-width: 800px) 432px, 50.3125vw"/>
  <ResponsiveImage class="tile tile--tr" src={assets['hero.imgImage3']} alt="" width="2735" height="2366" fetchpriority="high" sizes="(max-width: 800px) 432px, 50.3125vw"/>
  <ResponsiveImage class="tile tile--bl" src={assets['hero.imgImage2']} alt="" width="2735" height="2366" sizes="(max-width: 800px) 432px, 50.3125vw"/>
  <ResponsiveImage class="tile tile--br" src={assets['hero.imgImage1']} alt="" width="2735" height="2366" sizes="(max-width: 800px) 432px, 50.3125vw"/>
 </div>
 <div class="sky-shade" aria-hidden="true"></div>
 <h1 id="hero-title"><span class="hero-created editorial">Created</span><span class="hero-legendary display">for legendary</span><span class="hero-living editorial">living</span></h1>
 <div class="hero-explore"><Button label="Explore residences" href="#plans" variant="light"/></div>
 <div class="myth" data-scene="myth">
  <p class="myth-kicker editorial" data-reveal>Inspired by age-old myth</p>
  <img class="myth-type myth-type--ghost" src={assets['hero.imgRectangle']} alt="" width="1121" height="432" loading="lazy"/>
  <img class="myth-type" src={assets['hero.imgRectangle1']} alt="" width="1256" height="487" loading="lazy"/>
  <img class="myth-glow" src={assets['hero.imgEllipse10']} alt="" width="1148" height="588" loading="lazy"/>
  <p class="myth-copy" data-reveal><em>Inspired</em> by this tale, Atlantis, The Palm rose <em>majestically</em> from the deep. Now, as <em>Atlantis, The Royal</em> Resort &amp; Residences reaches to the sky, you can be part of this timeless story. <em>Become a founding</em> resident and <em>enjoy</em> an incomparable <em>luxury lifestyle</em> in a home of daring, pioneering creativity.</p>
 </div>
</section>
<style>
.hero-myth{position:relative;height:160.6944vw;min-height:1550px;overflow:hidden;background:var(--navy);color:white}.underwater{position:absolute;width:138.6111vw;height:138.6111vw;left:-19.3056vw;top:16.9444vw;opacity:.8;mask-image:var(--mask);mask-size:100% 100%;mask-repeat:no-repeat}.underwater img{width:100%;height:100%;object-fit:cover}.sunset-art{position:absolute;left:0;top:-4.1667vw;width:100.625vw;height:86.5082vw;mask-image:var(--mask);mask-size:99.3789% 100%;mask-repeat:no-repeat}.tile{position:absolute;width:50%;height:50%;max-width:none;object-fit:cover}.tile--tl{left:0;top:0}.tile--tr{left:50%;top:0}.tile--bl{left:0;top:50%}.tile--br{left:50%;top:50%}.sky-shade{position:absolute;inset:0 0 auto;height:28.54vw;background:linear-gradient(rgba(7,63,106,.6),transparent)}.hero-created,.hero-living,.hero-legendary{position:absolute;z-index:2;white-space:nowrap;line-height:.968}.hero-created,.hero-living{font-size:4.8611vw;letter-spacing:-.05em;color:white}.hero-created{right:54.2361%;top:10.7639vw}.hero-living{right:37.2222%;top:25.1389vw}.hero-legendary{left:50%;transform:translateX(-50%);top:15.5556vw;font-size:11.8056vw;letter-spacing:-.03em;color:var(--light-gold)}.hero-explore{display:none}.myth{position:absolute;top:105.2778vw;width:100%;height:50vw;text-align:center}.myth-kicker{position:relative;z-index:2;font-size:1.3889vw}.myth-type{position:absolute;top:4.4444vw;left:6.3889%;width:87.2222%;height:33.8194vw;object-fit:cover;opacity:.294;mix-blend-mode:screen}.myth-type--ghost{top:6.9444vw;left:11.1111%;width:77.8472%;height:30vw;filter:blur(2px);opacity:.096}.myth-glow{position:absolute;top:1.2vw;left:50%;transform:translateX(-50%);width:79.7222vw;height:40.8333vw;max-width:none}.myth-copy{position:absolute;top:15.3472vw;left:50%;transform:translateX(-50%);width:53.2639%;font-size:1.3889vw;line-height:1.64;letter-spacing:-.01em;text-transform:uppercase;color:rgba(255,255,255,.7)}.myth-copy em{font-size:1.2em;color:white}.hero-myth::after{content:'';position:absolute;bottom:0;left:0;width:100%;height:35.8333vw;background:linear-gradient(transparent,var(--navy) 86%);pointer-events:none}.myth{z-index:1}
@media(min-width:1921px){.hero-myth{min-height:0}}
@media(max-width:800px){.hero-myth{height:1504px;min-height:0}.sunset-art{width:864px;height:747.6px;left:calc(50% - 432px);top:140px;mask-size:99.3789% 100%;transform:none!important}.underwater{width:1000px;height:1000px;left:calc(50% - 500px);top:500px;opacity:.68}.sky-shade{top:80px;height:260px;background:linear-gradient(var(--navy) 30%,rgba(4,25,39,0));z-index:1}.hero-created,.hero-living{font-size:70px;left:50%;right:auto;transform:translateX(-50%)}.hero-created{top:130px}.hero-living{top:324px}.hero-legendary{top:208px;font-size:52px;line-height:56px;white-space:normal;text-align:center;width:342px;max-width:calc(100% - 40px)}.hero-explore{display:block;position:absolute;top:730px;left:50%;transform:translateX(-50%);z-index:2;width:284px}.hero-explore :global(.pill){width:100%}.myth{top:930px;height:480px;padding:0 24px}.myth-kicker{font-size:20px}.myth-type{width:820px;height:318px;max-width:none;left:calc(50% - 410px);top:78px}.myth-type--ghost{width:740px;height:285px;left:calc(50% - 370px);top:90px}.myth-glow{width:850px;height:435px;top:10px}.myth-copy{position:relative;top:auto;left:auto;transform:none;width:100%;max-width:440px;margin:62px auto 0;font-size:16px;line-height:1.75}.myth-copy em{font-size:20px}.hero-myth::after{height:320px}}
@media(max-width:360px){.hero-legendary{font-size:47px;line-height:52px}.myth-copy{font-size:15px}}
</style>
