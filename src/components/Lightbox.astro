<dialog id="media-dialog" class="media-dialog" aria-labelledby="media-caption">
 <button class="dialog-close" type="button" data-close aria-label="Close image">×</button>
 <div class="media-toolbar" data-zoom-toolbar hidden><button class="round-control" type="button" data-zoom-out aria-label="Zoom out">−</button><output data-zoom-value aria-live="polite">100%</output><button class="round-control" type="button" data-zoom-in aria-label="Zoom in">+</button><button class="link-line" type="button" data-zoom-fit>Fit plan</button></div>
 <div class="media-viewport" tabindex="0" aria-label="Image viewer"><div class="media-surface"><img data-media-image src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt=""/></div></div>
 <div class="media-footer"><p id="media-caption"></p><div class="media-gallery-controls" data-media-gallery hidden><button class="round-control" type="button" data-media-prev aria-label="Previous image">←</button><output data-media-count></output><button class="round-control" type="button" data-media-next aria-label="Next image">→</button></div></div>
</dialog>
<style>
.media-dialog{width:min(1280px,calc(100vw - 48px));height:min(900px,calc(100dvh - 48px));background:var(--cream);padding:64px 24px 20px;overflow:hidden}.media-viewport{height:calc(100% - 60px);width:100%;overflow:auto;overscroll-behavior:contain}.media-surface{width:100%;height:100%;display:flex;align-items:center;justify-content:center}.media-viewport img{display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;flex:none}.media-dialog.is-zoomed .media-viewport{cursor:grab}.media-dialog.is-zoomed .media-surface{width:max-content;height:max-content;min-width:100%;min-height:100%}.media-dialog.is-zoomed .media-viewport img{max-width:none;max-height:none}.media-dialog.is-zoomed .media-viewport.is-dragging{cursor:grabbing}.media-toolbar{position:absolute;left:24px;top:12px;display:flex;align-items:center;gap:16px}.media-toolbar output{min-width:44px;text-align:center;font-size:12px}.media-toolbar .link-line{margin-left:8px}.media-footer{height:60px;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:12px;line-height:1.5}.media-gallery-controls{display:flex;align-items:center;gap:18px;flex:none}.media-gallery-controls output{white-space:nowrap}.media-footer p{max-width:70%}
@media(max-width:800px){.media-dialog{width:calc(100vw - 24px);height:calc(100dvh - 24px);padding:70px 12px 12px}.media-footer{height:90px;flex-wrap:wrap;gap:8px;justify-content:center;text-align:center;padding-top:10px}.media-footer p{max-width:100%;width:100%;font-size:11px}.media-viewport{height:calc(100% - 90px)}.media-toolbar{left:12px;gap:8px}.media-toolbar .round-control{width:40px;height:40px}.media-toolbar .link-line{font-size:10px}.media-toolbar output{min-width:38px}.media-gallery-controls .round-control{width:36px;height:36px}}
</style>
