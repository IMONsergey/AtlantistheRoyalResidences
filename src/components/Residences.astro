---
import Icon from './Icon.astro';
import assets from '../data/assets.json';
import Button from './Button.astro';
const a=(key:string)=>(assets as Record<string,string>)[key];
---
<section class="residences-opening" aria-labelledby="residences-title" data-scene="residences">
 <picture class="residences-background"><source media="(max-width:800px)" srcset={a('mobileIntro.imgArchitectureBackground')}/><img src={a('intro.imgShutterstock24763543831')} alt="The towers of Atlantis The Royal framing the Dubai skyline" width="1570" height="905" loading="lazy"/></picture>
 <img class="residences-shape" src={a('intro.imgSubtract')} alt="" width="1440" height="937" loading="lazy"/>
 <div class="residences-heading"><p class="editorial" data-reveal>Expertly styled homes</p><h2 class="display" id="residences-title" data-reveal>38 <br/>properties <br/>as a way <br/>of life</h2><p class="residences-description" data-reveal>Crafted by the world’s leading designers, architects, and artists, these two-to-five-bedroom homes offer an <strong>unparalleled living experience.</strong></p></div>
 <picture class="residences-art"><source media="(max-width:800px)" srcset={a('mobileIntro.imgSignatureTexturedMask')}/><img src={a('intro.imgSubtract1')} alt="" width="1440" height="910" loading="lazy"/></picture>
</section>
<section id="plans" class="catalogue section-anchor" aria-labelledby="catalogue-title">
 <div class="catalogue-heading"><div><p class="editorial">Find your perspective</p><h2 class="display" id="catalogue-title">The residences</h2></div><p class="catalogue-note">Explore the residence in this collection.<br/>For current availability, register your interest.</p></div>
 <form id="residence-filters" class="filters" aria-label="Filter residences">
  <div><label for="bedroom-filter">Bedrooms</label><select id="bedroom-filter" name="bedrooms"><option value="">All bedrooms</option><option value="2">2 bedrooms</option><option value="3">3 bedrooms</option><option value="4">4 bedrooms</option><option value="5">5 bedrooms</option></select></div>
  <div><label for="area-filter">Total area</label><select id="area-filter" name="area"><option value="">All areas</option><option value="under-300">Under 300 sq m</option><option value="300-plus">300 sq m and above</option></select></div>
  <button type="reset" class="link-line">Reset filters</button>
  <p class="results" data-result-count role="status" aria-live="polite">1 residence in this collection</p>
 </form>
 <div data-unit-result>
  <div class="preview-options" aria-label="Residence preview"><button type="button" aria-pressed="true" data-unit-view="plan">Floor plan</button><button type="button" aria-pressed="false" data-unit-view="interior">Interior</button></div>
  <a class="unit-row" href="/residences/3402/" aria-label="Explore Unit 3402, four-bedroom Signature Residence Type 2">
   <div class="unit-arrangement"><p class="eyebrow">Arrangement</p><img class="building-diagram" src={a('catalogue.img202506071124531')} width="265" height="127" loading="lazy" alt="Position of the residence in the building"/><div class="level-diagram"><img src={a('catalogue.img202506071124321')} width="266" height="147" loading="lazy" alt="Residence position on level 34"/></div></div>
   <div class="unit-preview"><div data-plan-preview><div class="orientation-labels"><span>Level 34</span><span>View towards the ocean</span><span>N <Icon name="arrow-up-right" size={12}/></span></div><img class="plan-preview" src={a('catalogue.img202506071118051')} width="401" height="321" loading="lazy" alt="Four-bedroom residence floor plan"/><p class="palm-label">View towards The Palm</p></div><img class="interior-preview" data-interior-preview hidden src={a('unit.imgOpenInterior1')} width="2880" height="1920" loading="lazy" alt="Bedroom interior overlooking Dubai"/></div>
   <div class="unit-summary"><p class="eyebrow">4 bedroom Signature<br/>Residence Type 2</p><span class="unit-badge">Unit</span><h3 class="display">3402</h3><dl><div><dt>Total area</dt><dd>340.43 sq m</dd><dd>3,664 sq ft</dd></div><div><dt>Balcony</dt><dd>60.94 sq m</dd><dd>656 sq ft</dd></div></dl></div>
  </a>
  <div class="catalogue-action"><Button label="View floor plan" href="/residences/3402/#floor-plan"/></div>
 </div>
 <div class="no-results" data-no-results hidden><p class="editorial">A different kind of home?</p><h3 class="display">No matching residence</h3><p>There is no matching residence in this collection. Reset the filters or enquire about your requirements.</p><div><button class="pill pill--outline" type="button" data-reset-filters>Reset filters</button><Button label="Register your interest" context="Residence requirements"/></div></div>
</section>
<style>
.residences-opening{position:relative;height:62.8472vw;overflow:hidden;background:var(--navy)}.residences-background{position:absolute;top:0;left:-4.5139%;width:109.0278%;height:100%;max-width:none;object-fit:cover}.residences-shape{position:absolute;left:0;top:-2.0833vw;width:100%;height:65.0694vw;max-width:none;object-fit:fill}.residences-art{position:absolute;left:0;top:-2.0833vw;width:100%;height:63.1944vw;max-width:none;pointer-events:none;object-fit:fill;z-index:2}.residences-heading{position:absolute;left:50%;top:13.1944vw;transform:translateX(-50%);width:31.1111%;text-align:center;z-index:1}.residences-heading>.editorial{font-size:1.5972vw}.residences-heading h2{font-size:5.8333vw;line-height:.958;color:var(--gold);margin:3.4722vw auto 2.8472vw}.residences-description{font-size:1.0417vw;line-height:1.568;text-transform:uppercase;font-weight:300}.residences-description strong{font-weight:400}.catalogue{background:var(--cream)}.catalogue-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;padding:80px var(--page-gutter) 40px}.catalogue-heading .editorial{font-size:23px;margin-bottom:20px}.catalogue-heading h2{font-size:60px;color:var(--gold)}.catalogue-note{font-size:12px;line-height:1.8;color:#5d6264;text-align:right}.filters{display:flex;align-items:flex-end;gap:40px;padding:0 var(--page-gutter) 32px}.filters label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px}.filters select{background:transparent;border:0;border-bottom:1px solid var(--line);padding:10px 32px 10px 0;font-size:13px;min-width:170px;color:var(--navy)}.filters .link-line{font-size:10px;line-height:1.6}.filters .results{margin-left:auto;font-size:11px;line-height:1.6}.preview-options{display:flex;justify-content:center;gap:30px;padding:0 24px 24px}.preview-options button{font-size:12px;text-transform:uppercase;letter-spacing:.02em;padding:10px 0;border-bottom:1px solid transparent;color:#6e6e6e}.preview-options button[aria-pressed=true]{border-color:var(--navy);color:var(--navy)}.unit-row{display:grid;grid-template-columns:28% 44.78% 27.22%;min-height:425px;border-top:1px solid #f0ebe6;border-bottom:1px solid #f0ebe6;transition:box-shadow .3s}.unit-row:hover{box-shadow:0 12px 30px rgba(4,25,39,.08)}.unit-arrangement{background:#fff;padding:20px 30px;display:flex;flex-direction:column;align-items:center;border-right:1px solid #eee9e5}.unit-arrangement .eyebrow{margin-bottom:68px}.building-diagram{width:265px;height:127px;object-fit:contain;max-width:100%}.level-diagram{position:relative;width:188px;height:111px;overflow:hidden;margin:40px auto 0}.level-diagram img{position:absolute;top:0;left:-35.47%;width:141.53%;height:132.1%;max-width:none}.unit-preview{position:relative;background:rgba(255,255,255,.5);overflow:hidden;min-height:425px}.orientation-labels{display:flex;align-items:center;justify-content:space-between;padding:20px 40px;font-size:12px;line-height:1.4;text-transform:uppercase;font-weight:300;color:#6e7273}.orientation-labels span:nth-child(2){color:#a1a1a1}.plan-preview{width:401px;height:321px;object-fit:contain;mix-blend-mode:darken;margin:-9px auto 0;max-width:82%}.palm-label{text-align:center;font-size:12px;text-transform:uppercase;color:#aaa;line-height:1.3;margin:18px 0 0}.interior-preview{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.unit-summary{background:#a69584;color:white;text-align:center;display:flex;flex-direction:column;align-items:center;padding:21px 0 0}.unit-summary>.eyebrow{font-size:12px;line-height:1.5;margin-bottom:62px}.unit-badge{font-size:12px;text-transform:uppercase;padding:5px 12px;border-radius:40px;background:rgba(255,255,255,.12);line-height:1.4}.unit-summary h3{font-size:90px;font-weight:700;line-height:1;margin:16px 0 45px;letter-spacing:-.04em}.unit-summary dl{width:100%;padding:24px clamp(16px,5vw,72px);margin:0;background:rgba(174,159,143,.5);font-size:11px;line-height:1.4;text-transform:uppercase;font-weight:500}.unit-summary dl div{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid rgba(255,255,255,.45)}.unit-summary dl div:last-child{border-bottom:1px solid rgba(255,255,255,.45)}.unit-summary dt{font-weight:500;white-space:nowrap}.unit-summary dd{margin:0;white-space:nowrap}.catalogue-action{padding:32px 24px;text-align:center}.no-results{text-align:center;padding:72px 24px 96px;min-height:425px}.no-results .editorial{font-size:24px}.no-results h3{font-size:46px;margin:24px 0;color:var(--gold)}.no-results>p:not(.editorial){max-width:420px;margin:auto}.no-results>div{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:30px}
@media(max-width:1200px){.unit-summary dl{padding-inline:20px;font-size:10px}.orientation-labels{padding-inline:24px;font-size:10px}.unit-arrangement{padding-inline:20px}.unit-summary h3{font-size:82px}}
@media(max-width:800px){.residences-opening{height:720px}.residences-background{width:1248px;height:720px;left:calc(50% - 624px)}.residences-shape,.residences-art{width:1100px;height:695px;left:calc(50% - 550px);top:0}.residences-shape{height:716px}.residences-heading{top:118px;width:calc(100% - 70px);max-width:360px}.residences-heading>.editorial{font-size:22px}.residences-heading h2{font-size:52px;line-height:1;margin:32px auto}.residences-description{font-size:12px;line-height:1.7;max-width:280px;margin:auto}.catalogue-heading{padding:55px 24px 30px;display:block}.catalogue-heading .editorial{font-size:22px;margin-bottom:18px}.catalogue-heading h2{font-size:42px}.catalogue-note{text-align:left;margin-top:24px;font-size:12px}.filters{display:grid;grid-template-columns:1fr 1fr;gap:18px 20px;padding:0 24px 28px}.filters select{min-width:0;width:100%;font-size:12px;padding-right:20px}.filters .results{margin-left:0;text-align:right;font-size:10px}.filters .link-line{justify-self:start}.preview-options{justify-content:flex-start;gap:28px;padding-bottom:20px}.unit-row{display:flex;flex-direction:column;min-height:0;margin:0 24px;border:1px solid var(--line)}.unit-summary{order:0;padding:24px 0 0}.unit-summary>.eyebrow{font-size:12px;margin-bottom:24px}.unit-summary h3{font-size:78px;margin:16px 0 25px}.unit-summary dl{padding:18px 24px;font-size:11px}.unit-preview{order:1;min-height:350px}.orientation-labels{font-size:9px;padding:16px 14px}.plan-preview{width:300px;height:260px;max-width:93%;margin:0 auto}.palm-label{font-size:10px;margin-top:18px}.unit-arrangement{order:2;padding:22px;display:grid;grid-template-columns:1fr 1fr;gap:20px;border-top:1px solid var(--line);border-right:0}.unit-arrangement .eyebrow{grid-column:1/-1;margin:0;text-align:center;font-size:10px}.building-diagram{width:100%;height:90px}.level-diagram{width:100%;height:90px;margin:0}.level-diagram img{left:-28%;width:141%;height:132%;object-fit:contain}.catalogue-action{padding:24px}.catalogue-action :global(.pill){width:100%;max-width:342px}.no-results h3{font-size:38px}.no-results>div{flex-direction:column;max-width:342px;margin:30px auto 0}}
</style>
<style>
/* Keep every area value readable on narrow phones without shrinking type. */
@media(max-width:359px){
 .unit-summary dl{padding:18px 16px;font-size:12px}
 .unit-summary dl div{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;column-gap:10px;row-gap:2px;padding:9px 0}
 .unit-summary dt{grid-column:1;grid-row:1 / span 2;white-space:normal;text-align:left;line-height:1.35}
 .unit-summary dd{grid-column:2;white-space:nowrap;text-align:right;line-height:1.3}
}
</style>
<style>
.residences-background img,.residences-art img{width:100%;height:100%;object-fit:cover}.residences-art img{object-fit:fill}
@media(max-width:800px){.residences-opening{height:740px;background:var(--cream)}.residences-background{left:0;top:0;width:100%;height:740px}.residences-shape{display:none}.residences-art{width:1008px;height:637px;left:calc(50% - 504px);top:40px}.residences-heading{top:132px;display:flex;flex-direction:column;gap:20px;width:calc(100% - 90px);max-width:300px;height:auto;z-index:3}.residences-heading>.editorial{font-size:22px;line-height:26px;text-transform:uppercase;width:100%}.residences-heading h2{font-size:46px;line-height:46px;letter-spacing:.01em;margin:0;width:100%;text-box-trim:trim-both;text-box-edge:cap alphabetic}.residences-heading h2 br{display:none}.residences-description{font-size:15px;line-height:23px;width:100%;max-width:none;margin:0}}
</style>
<style>
@media(min-width:801px){.residences-opening{height:59.0278vw}.residences-background{height:62.8472vw}.residences-heading{height:38vw}.residences-heading h2{position:absolute;left:0;top:4.8611vw;width:100%;margin:0;text-box-trim:trim-both;text-box-edge:cap alphabetic}.residences-description{position:absolute;left:0;top:28.9583vw;width:100%;margin:0}}
</style>
