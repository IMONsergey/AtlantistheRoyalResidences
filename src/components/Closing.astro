---
import assets from '../data/assets.json';
import Button from './Button.astro';
const a=(key:string)=>(assets as Record<string,string>)[`footer.${key}`];
---
<section class="closing" aria-labelledby="dream-title">
 <div class="dream-art" aria-hidden="true">
  <div class="dream-building" style={`--mask:url('${a('img22')}')`}><img src={a('img23')} alt="" width="1440" height="976" loading="lazy"/></div>
  <div class="dream-sea" style={`--mask:url('${a('imgShutterstock17273486772')}')`}><img src={a('imgShutterstock17273486773')} alt="" width="2592" height="834" loading="lazy"/></div>
  <div class="yacht-wake" style={`--mask-a:url('${a('imgDe6F86905020335E18C230133D84')}');--mask-b:url('${a('imgDe6F86905020335E18C230133D85')}');--mask-c:url('${a('imgDe6F86905020335E18C230133D86')}')`}><img src={a('imgDe6F86905020335E18C230133D87')} alt="" width="1080" height="1080" loading="lazy"/></div>
  <div class="yacht" data-parallax="-3"><img src={a('imgDe6F86905020335E18C230133D83Photoroom1')} alt="" width="385" height="648" loading="lazy"/><img class="yacht-light" style={`--mask:url('${a('imgDe6F86905020335E18C230133D83Photoroom3')}')`} src={a('imgDe6F86905020335E18C230133D83Photoroom4')} alt="" width="385" height="648" loading="lazy"/></div>
  <div class="yacht-haze" style={`--mask:url('${a('imgRectangle151')}')`}></div>
  <div class="dream-sea-shade"></div>
 </div>
 <div class="dream-heading"><p class="editorial" data-reveal>Live the dream</p><h2 class="display" id="dream-title" data-reveal>Today, tomorrow<br/>or forever</h2></div>
 <div id="contacts" class="contact-cards section-anchor">
  <article class="resource-card" data-reveal><img class="resource-image" src={a('imgRectangle155')} alt="Atlantis The Royal Residences presentation cover" width="410" height="205" loading="lazy"/><div class="card-content"><h3 class="display">Presentation<br/>deck</h3><p>Explore the content about Dubai’s most luxurious residences.</p><Button label="Request presentation" context="Presentation deck request" variant="outline"/></div></article>
  <article class="consultation-card" data-reveal><img class="portrait" src={a('imgEllipse20')} alt="Residence consultation" width="151" height="151" loading="lazy"/><h3 class="display">Get a<br/>consultation<br/>with an expert</h3><p>Tell us what you are looking for.<br/>Register your interest for more information.</p><Button label="Register your interest" context="Residence consultation"/></article>
  <article class="resource-card" data-reveal><img class="resource-image" src={a('imgRectangle156')} alt="The residence floor plans catalogue" width="410" height="205" loading="lazy"/><div class="card-content"><h3 class="display">Floor plans<br/>catalogue</h3><p>Explore the layout options<br/>and residence details.</p><Button label="Request catalogue" context="Floor plans catalogue request" variant="outline"/></div></article>
 </div>
 <footer class="site-footer"><div class="footer-links"><a href="/">Atlantis The Royal Residences, Dubai</a><a href="/privacy/">Privacy notice</a></div><a class="footer-logo" style={`--mask:url('${a('imgRectangle145')}')`} href="/" aria-label="Atlantis The Royal Residences, home"></a><p>Copyright © {new Date().getFullYear()}. All rights reserved.</p></footer>
</section>
<style>
.closing{position:relative;background:linear-gradient(var(--cream) 0 108.8194vw,var(--navy) 108.8194vw);overflow:hidden;padding-top:91.4583vw}.dream-art{position:absolute;top:0;left:0;width:100%;height:108.8194vw;pointer-events:none}.dream-building{position:absolute;top:-2.5vw;left:0;width:100%;height:67.7778vw;mask-image:var(--mask);mask-size:100% 100%;opacity:.9}.dream-building img{width:100%;height:100%;object-fit:cover}.dream-sea{position:absolute;top:50.9028vw;left:-40%;width:180%;height:57.9167vw;mask-image:var(--mask);mask-size:100% 100%}.dream-sea img{width:100%;height:100%;object-position:bottom}.yacht-wake{position:absolute;left:29.8611%;top:22.8472vw;width:42.0139%;height:65.9722vw;mask-image:var(--mask-a),var(--mask-b),var(--mask-c);mask-size:100% 62.9474%,100% 62.9474%,100% 100%;mask-position:0 24.4444vw,0 24.4444vw,0 0;mask-repeat:no-repeat;mask-composite:intersect;overflow:hidden}.yacht-wake img{position:absolute;top:-13.68%;left:-78.51%;width:178.51%;height:113.68%;max-width:none}.yacht{position:absolute;left:36.8056%;top:26.0417vw;width:26.7361%;height:45vw}.yacht img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.yacht .yacht-light{mask-image:var(--mask);mask-size:100% 100%}.yacht-haze{position:absolute;left:26.0417%;top:25.3472vw;width:54.1667%;height:66.875vw;background:linear-gradient(rgba(254,248,244,.7) 2.85%,rgba(254,248,244,.58) 22%,transparent 39.7%);mask-image:var(--mask);mask-size:77.5641% 93.8733%;mask-position:3.8194vw .6944vw;mask-repeat:no-repeat}.dream-sea-shade{position:absolute;top:50.1389vw;left:0;width:100%;height:58.6806vw;background:linear-gradient(transparent 5.44%,rgba(4,25,39,.67) 61.75%,var(--navy) 98.86%)}.dream-heading{position:absolute;top:24.5139vw;left:50%;transform:translateX(-50%);width:70%;text-align:center}.dream-heading>.editorial{font-size:3.4722vw;line-height:.968;margin-bottom:2.8472vw}.dream-heading h2{font-size:6.9444vw;line-height:1.158;color:var(--gold)}.contact-cards{position:relative;z-index:2;display:grid;grid-template-columns:repeat(3,1fr);gap:30px;width:89.5833%;margin:0 auto;align-items:stretch}.resource-card,.consultation-card{background:var(--cream);text-align:center;min-width:0;min-height:531px}.resource-image{width:100%;height:14.2361vw;object-fit:cover}.card-content{padding:40px 28px 48px;display:flex;align-items:center;flex-direction:column}.contact-cards h3{font-size:32px;line-height:1}.contact-cards p{font-size:12px;line-height:1.83;text-transform:uppercase;font-weight:300;letter-spacing:-.01em;margin:32px 0 36px;min-height:44px}.contact-cards :global(.pill){min-width:229px;max-width:100%;padding-inline:20px;font-size:11px}.consultation-card{padding:57px 28px 48px;transform:translateY(-57px);margin-bottom:-57px;display:flex;flex-direction:column;align-items:center}.portrait{width:151px;height:151px;border-radius:50%;object-fit:cover;margin-bottom:56px}.consultation-card p{margin-top:32px}.consultation-card :global(.pill){margin-top:auto}.site-footer{position:relative;z-index:2;background:var(--navy);color:white;display:grid;grid-template-columns:1fr 136px 1fr;align-items:center;gap:40px;margin-top:55px;padding:0 var(--page-gutter) 48px;font-size:10px;line-height:1.578;text-transform:uppercase}.footer-links{display:flex;align-items:center;gap:27px}.footer-links>a:last-child{text-decoration:underline;text-underline-offset:2px}.footer-logo{display:block;width:136px;height:86.6px;background:white;mask-image:var(--mask);mask-size:contain;mask-repeat:no-repeat;mask-position:center}.site-footer>p{text-align:right}
@media(max-width:1200px) and (min-width:801px){.contact-cards{gap:20px}.contact-cards h3{font-size:27px}.card-content{padding:32px 20px 40px}.consultation-card{padding-inline:20px}.contact-cards :global(.pill){min-width:0;width:100%;font-size:10px;padding-inline:14px}.contact-cards p{font-size:11px}.footer-links{gap:18px;flex-wrap:wrap}.site-footer{gap:24px}}
@media(max-width:800px){.closing{padding-top:830px;background:linear-gradient(var(--cream) 0 850px,var(--navy) 1000px)}.dream-art{height:1050px}.dream-building{top:0;left:calc(50% - 600px);width:1200px;height:813px;opacity:.55}.dream-sea{top:445px;left:calc(50% - 900px);width:1800px;height:580px}.yacht-wake{left:calc(50% - 202px);top:235px;width:404px;height:634px;mask-size:100% 62.9474%,100% 62.9474%,100% 100%;mask-position:0 235px,0 235px,0 0}.yacht{left:calc(50% - 128px);top:265px;width:257px;height:433px;transform:none!important}.yacht-haze{left:calc(50% - 260px);top:260px;width:520px;height:642px;mask-size:77.56% 93.87%;mask-position:36.7px 6.7px}.dream-sea-shade{top:440px;height:610px}.dream-heading{top:100px;width:calc(100% - 48px);max-width:600px}.dream-heading>.editorial{font-size:34px;line-height:1.1;margin-bottom:28px}.dream-heading h2{font-size:49px;line-height:1.07}.contact-cards{display:flex;flex-direction:column;width:calc(100% - 48px);max-width:480px;gap:24px}.resource-card,.consultation-card{min-height:0}.resource-card{order:1}.consultation-card{order:0;transform:none;margin:0;padding:42px 28px}.portrait{width:130px;height:130px;margin-bottom:34px}.contact-cards h3{font-size:32px}.contact-cards p{font-size:12px;margin:28px 0 30px}.contact-cards :global(.pill){min-width:0;width:100%;max-width:284px}.resource-image{height:180px}.card-content{padding:32px 28px 40px}.site-footer{display:flex;flex-direction:column;gap:30px;text-align:center;margin-top:60px;padding:0 24px 40px;font-size:10px}.footer-logo{order:0}.footer-links{order:1;flex-direction:column;gap:16px}.site-footer>p{order:2;text-align:center}}
</style>
