---
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import GalleryStatus from './GalleryStatus.astro';
import assets from '../data/assets.json';
const a=(key:string)=>(assets as Record<string,string>)[key];
const highlights=[
 {key:'space',sizes:'(max-width: 800px) 478px, max(61.231vw, 519px)',kicker:'Reaching purposefully to the sky',title:'A majestic balance of space and light',copy:'True to the spirit of ancient Atlantis, world-class designers have created an environment that is endowed with enticing pools and luxuriant gardens. The Residences will have expansive living and entertaining spaces with balconies or lushly landscaped terraces.',photo:a('highlightSpace.img4'),background:a('highlightSpace.imgSubtract'),overlays:[a('highlightSpace.imgSubtract1'),a('highlightSpace.imgSubtract2')],alt:'An open-air pavilion with sculptural pendant lights and tropical gardens'},
 {key:'pool',sizes:'(max-width: 800px) 582px, max(74.589vw, 632px)',kicker:'Infinitely enjoyable',title:'Beyond the extremities of the imagination',copy:'A 90-metre sky-high infinity pool is the ultimate haven for resort guests and residents to lounge, socialise or play. Under the setting sun, with Dubai glowing on the horizon, the ultra-pool lounge comes alive as the twilight destination for unparalleled sophistication.',photo:a('highlightPool.imgImage'),background:a('highlightPool.imgSubtract'),overlays:[],alt:'An infinity pool overlooking the sweeping curve of Palm Jumeirah'},
 {key:'beach',sizes:'(max-width: 800px) 491px, max(62.9167vw, 533px)',kicker:'A beautiful shore',title:'With an outlook of boundless sea',copy:'Atlantis, The Royal Resort & Residences faces the iconic Dubai skyline above the waters of The Palm in one direction and nothing but open sea and sky in the other. The private beach offers redefined waters-edge dining.',photo:a('beach.imgImage26'),background:a('beach.imgSubtract'),overlays:[a('beach.imgGroup1000003367')],alt:'A sunlit stroll along the water’s edge'},
];
---
<section id="highlights" class="highlights section-anchor" aria-labelledby="highlights-title" aria-roledescription="carousel" tabindex="0" data-slider>
 <h2 id="highlights-title" class="sr-only">Life at Atlantis The Royal</h2>
 {highlights.map((slide,index)=><article class={`highlight highlight--${slide.key}`} data-slide hidden={index!==0} aria-label={`${index+1} of 3: ${slide.title}`}>
  <div class="highlight-art" aria-hidden="true"><ResponsiveImage class="highlight-photo" src={slide.photo} alt="" loading="lazy" width="1024" height="604" sizes={slide.sizes}/><img class="highlight-mask" src={slide.background} width="1440" height="910" alt="" loading="lazy"/>{slide.overlays.map(src=><img class="highlight-mask" src={src} alt="" width="1440" height="910" loading="lazy"/>)}</div>
  <p class="highlight-kicker editorial">{slide.kicker}</p>
  <div class="highlight-info"><h3 class="display">{slide.title}</h3>
  <p class="highlight-copy">{slide.copy}</p></div>
 </article>)}
 <div class="highlight-controls"><button class="round-control" type="button" data-prev aria-label="Previous highlight"><Icon name="arrow-left" size={20}/></button><div class="highlight-dots" aria-label="Choose a highlight">{highlights.map((slide,i)=><button type="button" data-slide-to={i} aria-current={i===0?'true':'false'} aria-label={`Show ${slide.key} highlight`}><span></span></button>)}</div><output class="sr-only" aria-live="polite" data-slider-count>1 / 3</output><button class="round-control" type="button" data-next aria-label="Next highlight"><Icon name="arrow-right" size={20}/></button></div>
 <GalleryStatus placement="highlights"/>
</section>
<style>
.highlights{position:relative;height:59.0278vw;min-height:500px;background:var(--navy);color:white;overflow:hidden}.highlight{position:absolute;inset:0}.highlight-art{position:absolute;inset:0;width:100%;height:100%}.highlight-photo{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:60.0694%;height:69.1765%;object-fit:cover;max-width:none}.highlight--pool .highlight-photo{width:71.1111%;height:70.94%}.highlight--beach .highlight-photo{width:62.9167%;height:71.0588%;left:57.3611%;top:49.4118%}.highlight-mask{position:absolute;left:0;top:-3.5294%;width:100%;height:107.0588%;max-width:none;object-fit:fill}.highlight-kicker{position:absolute;left:0;top:4.1667vw;width:100%;text-align:center;font-size:1.5972vw}.highlight h3{position:absolute;left:3.06%;top:25.4167vw;width:23.4%;text-align:center;font-size:2.7083vw;line-height:1.168}.highlight-copy{position:absolute;left:74.6528%;top:50%;transform:translateY(-50%);width:20.9722%;text-align:center;font-size:.8333vw;line-height:1.978;letter-spacing:-.01em;font-weight:500}.highlight-controls{position:absolute;bottom:3vw;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:28px;z-index:4}.highlight-dots{display:flex;gap:3px}.highlight-dots button{width:30px;height:44px;display:grid;place-items:center;padding:0}.highlight-dots span{width:8px;height:8px;border:1px solid white;border-radius:50%;transition:background .2s}.highlight-dots button[aria-current=true] span{background:white}.highlight-controls .round-control{border-color:rgba(255,255,255,.6)}.highlight-controls .round-control:hover{background:white;color:var(--navy)}
@media(max-width:1100px) and (min-width:801px){.highlight-copy{font-size:11px}.highlight-controls{bottom:16px}}
@media(max-width:800px){.highlights{height:810px;min-height:0}.highlight-art{width:780px;height:460.42px;left:calc(50% - 390px);inset-block:0 auto}.highlight::after{content:'';position:absolute;left:0;top:410px;width:100%;height:70px;background:linear-gradient(transparent,var(--navy));pointer-events:none}.highlight-kicker{font-size:20px;top:26px;padding:0 24px}.highlight h3{left:24px;top:466px;width:calc(100% - 48px);font-size:34px;line-height:1.04;text-align:center;max-width:520px}.highlight-copy{left:24px;top:562px;transform:none;width:calc(100% - 48px);font-size:13px;line-height:1.8;max-width:520px;font-weight:400}.highlight-controls{bottom:23px;gap:20px}.highlight-dots button{width:28px}.highlight--pool h3{font-size:32px}}
@media(min-width:540px) and (max-width:800px){.highlight h3,.highlight-copy{left:50%;transform:translateX(-50%)}.highlight-copy{top:555px}}
@media(max-width:360px){.highlights{height:850px}.highlight-copy{top:572px}.highlight h3{font-size:32px}}
</style>
<style>.highlight-info{display:contents}.highlight-kicker,.highlight h3,.highlight-copy{z-index:2}@media(max-width:800px){.highlight-info{display:block;position:absolute;left:24px;top:466px;width:calc(100% - 48px);max-width:520px;z-index:2}.highlight-info h3{position:static;width:100%;max-width:none;transform:none;font-size:34px;line-height:1.04}.highlight-info .highlight-copy{position:static;width:100%;max-width:none;transform:none;margin-top:24px;font-size:13px;line-height:1.8}.highlight::after{z-index:1}}@media(min-width:540px) and (max-width:800px){.highlight-info{left:50%;transform:translateX(-50%)}}@media(max-width:360px){.highlight-info h3{font-size:32px}}</style>
